pkgname=localsearch
pkgver=3.9.0
pkgrel=1
pkgdesc="Filesystem indexer as well as a metadata extractor"
arch=(x86_64)
depends=(gexiv2 gst-plugins-base tinysparql exempi giflib icu libexif libseccomp poppler
	upower libgsf networkmanager totem-pl-parser)
makedepends=(base-devel)
source=(https://download.gnome.org/sources/localsearch/3.9/localsearch-3.9.0.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build

	cd build
	meson \
	--prefix=/usr \
	--buildtype=release \
	-D man=false \
	-D landlock=disabled \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
