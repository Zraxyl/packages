pkgname=tecla
pkgver=48.0.2
pkgrel=1
arch=(x86_64)
depends=(libadwaita libxkbcommon)
makedepends=(base-devel docbook-xml docbook-xsl)
source=(https://download.gnome.org/sources/tecla/48/tecla-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
