pkgname=gnome-screenshot
pkgver=41.0
pkgrel=1
pkgdesc="GNOME Screenshot is a utility used for taking screenshots of the entire screen, a window or a user-defined area of the screen, with optional beautifying border effects."
arch=(x86_64)
depends=(gtk3+ libcanberra libhandy)
makedepends=(docbook-xml docbook-xsl)
source=(https://download.gnome.org/sources/gnome-screenshot/41/gnome-screenshot-$pkgver.tar.xz)

prepare() {
	sed -i '/merge_file/{n;d}' $pkgname-$pkgver/data/meson.build

	rm -rf build
	mkdir -p build
	cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
