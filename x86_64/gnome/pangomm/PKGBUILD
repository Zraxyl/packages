pkgname=pangomm
pkgver=2.56.1
pkgrel=2
arch=('x86_64')
depends=(cairomm glibmm pango)
source=(https://download.gnome.org/sources/$pkgname/2.56/$pkgname-$pkgver.tar.xz
	https://download.gnome.org/sources/$pkgname/2.46/$pkgname-2.46.4.tar.xz)

prepare() {
	mkdir -p build1 build2

	cd $srcdir/build1
	meson \
	--prefix=/usr \
	--buildtype=release \
	../$pkgname-2.46.4

	cd $srcdir/build2
	meson \
	--prefix=/usr \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd $srcdir/build1
	ninja

	cd $srcdir/build2
	ninja
}

package() {
	cd $srcdir/build1
	DESTDIR=$pkgdir ninja install

	cd $srcdir/build2
	DESTDIR=$pkgdir ninja install
}
