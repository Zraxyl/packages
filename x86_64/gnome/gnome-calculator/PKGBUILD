pkgname=gnome-calculator
pkgver=48.1
pkgrel=1
pkgdesc="GNOME Calculator is a powerful graphical calculator with financial, logical and scientific modes"
arch=(x86_64)
depends=(gtksourceview libadwaita libgee libsoup)
makedepends=(itstool vala)
source=(https://download.gnome.org/sources/gnome-calculator/48/$pkgname-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build
	cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
