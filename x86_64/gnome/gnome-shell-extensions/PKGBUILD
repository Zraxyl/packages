pkgname=gnome-shell-extensions
pkgver=48.2
pkgrel=1
pkgdesc="The GNOME Shell Extensions package contains a collection of extensions providing additional and optional functionality to the GNOME Shell"
arch=(x86_64)
depends=(libgtop gnome-menus)
makedepends=(gtk-doc sassc)
source=(https://download.gnome.org/sources/$pkgname/48/$pkgname-$pkgver.tar.xz)

prepare() {
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
