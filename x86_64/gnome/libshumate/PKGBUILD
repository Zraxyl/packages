pkgname=libshumate
pkgver=1.4.0
pkgrel=1
arch=(x86_64)
depends=(gtk4+ libsoup gobject-introspection cairo gdk-pixbuf protobuf-c pango)
makedepends=(gtk-doc)
source=(https://download.gnome.org/sources/$pkgname/1.4/$pkgname-$pkgver.tar.xz)

prepare() {
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	--wrap-mode=nofallback \
	-D gtk_doc=false \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
