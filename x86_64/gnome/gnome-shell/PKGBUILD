pkgname=gnome-shell
pkgver=48.2
pkgrel=1
arch=(x86_64)
depends=(evolution-data-server gcr gjs gnome-desktop ibus mutter
	polkit gnome-menus sassc startup-notification desktop-file-utils gnome-autoar
	gnome-bluetooth gst-plugins-base networkmanager)
makedepends=(gtk-doc python3-pip docbook-xml docbook-xsl)
source=(https://download.gnome.org/sources/$pkgname/48/$pkgname-$pkgver.tar.xz)

prepare() {
	mkdir -p build && cd build

	pip3 install docutils
	export PATH=$PATH:/home/developer/.local/bin

	meson \
	--prefix=/usr \
	--buildtype=release \
	-D tests=false \
	-D gtk_doc=false \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
