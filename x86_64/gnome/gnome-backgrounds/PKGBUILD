pkgname=gnome-backgrounds
pkgver=48.2.1
pkgrel=1
arch=('x86_64')
depends=(libjxl)
makedepends=(git gtk-doc)
source=(https://download.gnome.org/sources/$pkgname/48/$pkgname-$pkgver.tar.xz)

prepare() {
	cd $pkgname-$pkgver

	mkdir -p build
}

build() {
	cd $pkgname-$pkgver/build

	meson \
	--prefix=/usr \
	..

	ninja
}

package() {
	cd $pkgname-$pkgver/build

	DESTDIR=$pkgdir ninja install
}
