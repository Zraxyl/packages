pkgname=gdm
pkgver=48.0
pkgrel=4
arch=('x86_64')
depends=(accountsservice dconf libcanberra gtk3+ linux-pam
	gnome-session gnome-shell systemd upower libxdmcp
	xorg-server wayland)
makedepends=(git gtk-doc plymouth meson gobject-introspection docbook-xml
	docbook-xsl)
install=gdm.install
source=(https://download.gnome.org/sources/$pkgname/48/$pkgname-$pkgver.tar.xz
	001.patch
	002.patch)

prepare() {
	cd $pkgname-$pkgver

	patch -p1 -i ../001.patch -d .
	patch -p1 -i ../002.patch -d .

	rm -rf build
	mkdir -p build && cd build

	CC=clang \
	CXX=clang++ \
	meson \
	--prefix=/usr \
	--buildtype=release \
	-D dbus-sys="/usr/share/dbus-1/system.d" \
	-D default-path="/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin" \
	-D gdm-xsession=true \
	-D default-pam-config=arch \
	-D wayland-support=true \
	-D ipv6=true \
	-D plymouth=disabled \
	-D run-dir=/run/gdm \
	-D selinux=disabled \
	..
}

build() {
	cd $pkgname-$pkgver/build

	ninja
}

package() {
	cd $pkgname-$pkgver/build

	DESTDIR=$pkgdir ninja install

	install -d -o   0 -g   0 -m 0755 $pkgdir/var
	install -d -o   0 -g   0 -m 0755 $pkgdir/var/lib
	install -d -o 120 -g 120 -m 1770 $pkgdir/var/lib/gdm
	install -d -o 120 -g 120 -m 0700 $pkgdir/var/lib/gdm/.config
	install -d -o 120 -g 120 -m 0700 $pkgdir/var/lib/gdm/.config/pulse
	install -d -o 120 -g 120 -m 0700 $pkgdir/var/lib/gdm/.local
	install -d -o 120 -g 120 -m 0755 $pkgdir/var/lib/gdm/.local/share
	install -d -o 120 -g 120 -m 0755 $pkgdir/var/lib/gdm/.local/share/applications

	# https://src.fedoraproject.org/rpms/gdm/blob/master/f/default.pa-for-gdm
	install -o120 -g120 -m644 /dev/stdin $pkgdir/var/lib/gdm/.config/pulse/default.pa <<END
load-module module-device-restore
load-module module-card-restore
load-module module-udev-detect
load-module module-native-protocol-unix
load-module module-default-device-restore
load-module module-always-sink
load-module module-intended-roles
load-module module-suspend-on-idle
load-module module-systemd-login
load-module module-position-event-sounds
END

	install -Dm644 /dev/stdin $pkgdir/usr/lib/sysusers.d/gdm.conf <<END
g gdm 120 -
u gdm 120 "Gnome Display Manager" /var/lib/gdm
END


}
