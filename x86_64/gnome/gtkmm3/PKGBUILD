pkgname=gtkmm3
pkgver=3.24.10
pkgrel=1
arch=('x86_64')
depends=(atkmm gtk3+ pangomm glibmm cairomm cairo)
makedepends=(doxygen mm-common)
source=(https://download.gnome.org/sources/gtkmm/3.24/gtkmm-$pkgver.tar.xz)

prepare() {
	cd gtkmm-$pkgver

	rm -rf build
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	--wrap-mode=nofallback \
	..
}

build() {
	cd gtkmm-$pkgver/build

	ninja
}

package() {
	cd gtkmm-$pkgver/build

	DESTDIR=$pkgdir ninja install
}
