pkgname=gnome-disk-utility
pkgver=46.1
pkgrel=1
pkgdesc="GNOME Disk Utility package provides applications used for dealing with storage devices"
arch=(x86_64)
depends=(gnome-settings-daemon libdvdread libhandy libpwquality libsecret udisks2 appstream-glib)
makedepends=(itstool docbook-xml docbook-xsl)
source=(https://download.gnome.org/sources/gnome-disk-utility/46/gnome-disk-utility-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build
	cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
