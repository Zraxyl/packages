pkgname=file-roller
pkgver=44.5
pkgrel=1
pkgdesc="Create and modify archives"
url="https://wiki.gnome.org/Apps/FileRoller"
arch=(x86_64)
depends=(gtk4+ cpio desktop-file-utils json-glib libarchive libadwaita libportal unrar zip)
makedepends=(git meson itstool nautilus)
optdepends=('p7zip: 7z, arj, exe and encrypted zip files support'
	'unrar: better RAR archive support'
	'unace: ACE archive support'
	'lrzip: lrzip archive support'
	'squashfs-tools: squashfs image support')
source=(https://download.gnome.org/sources/file-roller/44/file-roller-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build
	cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build
	ninja
}

package() {
	cd build
	DESTDIR="$pkgdir" ninja install
}
