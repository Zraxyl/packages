pkgname=gnome-online-accounts
pkgver=3.54.3
pkgrel=1
arch=('x86_64')
depends=(gcr json-glib rest webkit2gtk gobject-introspection
	libsoup krb5 libadwaita)
makedepends=(vala docbook-xsl docbook-xml)
source=(https://download.gnome.org/sources/gnome-online-accounts/3.54/gnome-online-accounts-$pkgver.tar.xz)

prepare() {
	cd $pkgname-$pkgver

	mkdir -p build
}

build() {
	cd $pkgname-$pkgver/build

	meson \
	--prefix=/usr \
	--buildtype=release \
	--wrap-mode=nofallback \
	-D documentation=false \
	..

	ninja
}

package() {
	cd $pkgname-$pkgver/build

	DESTDIR=$pkgdir ninja install
}
