pkgname=libpeas
pkgver=2.0.7
pkgrel=1
arch=(x86_64)
depends=(gobject-introspection gtk3+ libxml2 python3-gobject vala gjs lua)
makedepends=(gtk-doc)
source=(https://download.gnome.org/sources/$pkgname/2.0/$pkgname-$pkgver.tar.xz)

prepare() {
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	--wrap-mode=nofallback \
	-D vapi=true \
	-D lua51=false \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
