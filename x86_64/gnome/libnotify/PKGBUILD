pkgname=libnotify
pkgver=0.8.6
pkgrel=1
pkgdesc="Library for sending desktop notifications"
arch=('x86_64')
depends=(gdk-pixbuf glib2 glibc)
makedepends=(gobject-introspection gtk-doc notification-daemon)
source=(https://download.gnome.org/sources/$pkgname/0.8/$pkgname-$pkgver.tar.xz)

prepare() {
	cd $pkgname-$pkgver

	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	-D gtk_doc=false \
	-D man=false \
	..
}

build() {
	cd $pkgname-$pkgver/build
	ninja
}

package() {
	cd $pkgname-$pkgver/build

	DESTDIR=$pkgdir meson install
}
