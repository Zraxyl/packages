pkgname=gjs
pkgver=1.84.2
pkgrel=1
arch=(x86_64)
depends=(cairo dbus gobject-introspection gtk3+ gtk4+ js128)
source=(https://download.gnome.org/sources/gjs/1.84/gjs-$pkgver.tar.xz)

prepare() {
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	--wrap-mode=nofallback \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
