pkgname=gnome-bluetooth
pkgver=47.1
pkgrel=1
arch=(x86_64)
depends=(gtk4+ gsound libnotify upower gobject-introspection
	libadwaita bluez)
makedepends=(gtk-doc)
source=(https://download.gnome.org/sources/$pkgname/47/$pkgname-$pkgver.tar.xz)

prepare() {
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	--wrap-mode=nofallback \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
