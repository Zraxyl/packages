pkgname=vte
pkgver=0.80.2
pkgrel=1
pkgdesc="Contains a virtual terminal widget for GTK applications"
arch=('x86_64')
depends=(gtk+ gtk4+ libxml2 pcre2 icu vala gobject-introspection gnutls fribidi
	libxdmcp fast_float)
makedepends=(base-devel)
source=(https://gitlab.gnome.org/GNOME/$pkgname/-/archive/$pkgver/$pkgver-$pkgver.tar.bz2)

build() {
	cd $pkgname-$pkgver*

	mkdir -p build && cd build

	# vapi is disabled as of gtk issues

	meson \
	--prefix=/usr \
	--buildtype=release \
	-D fribidi=true \
	-D gtk3=true \
	-D gtk4=true \
	-D vapi=false \
	-D _systemd=true \
	-D gnutls=true

	ninja
}

package() {
	cd $pkgname-$pkgver*/build

	DESTDIR=$pkgdir ninja install
}
