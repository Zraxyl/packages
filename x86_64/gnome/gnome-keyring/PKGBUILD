pkgname=gnome-keyring
pkgver=48.0
pkgrel=1
arch=(x86_64)
depends=(dbus gcr linux-pam libxslt openssh gnupg gobject-introspection)
makedepends=(gtk-doc docbook-xml docbook-xsl)
source=(https://download.gnome.org/sources/$pkgname/48/$pkgname-$pkgver.tar.xz)

prepare() {
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
