pkgname=gnome-terminal
pkgver=3.56.2
pkgrel=1
pkgdesc="Terminal emulator for GNOME Desktop"
arch=(x86_64)
depends=(dconf gnome-shell gsettings-desktop-schemas libhandy pcre2 vte
	appstream desktop-file-utils)
makedepends=(itstool vala nautilus gnome-common docbook-xsl docbook-xml gtk-doc)
source=(https://download.gnome.org/sources/gnome-terminal/3.56/gnome-terminal-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build
	cd build

	CC=clang \
	CXX=clang++ \
	meson \
	--wrap-mode=nofallback \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
