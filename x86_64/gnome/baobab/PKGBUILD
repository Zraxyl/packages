pkgname=baobab
pkgver=48.0
pkgrel=1
pkgdesc="Graphical directory tree analyzer"
arch=(x86_64)
depends=(adwaita-icon-theme gtk4+ libadwaita)
makedepends=(itstool vala)
source=(https://download.gnome.org/sources/baobab/48/baobab-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build
	cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
