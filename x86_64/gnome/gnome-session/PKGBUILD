pkgname=gnome-session
pkgver=48.0
pkgrel=2
pkgdesc="The GNOME Session Handler"
arch=(x86_64)
depends=(bash dconf glib2 gnome-desktop gnome-keyring
	gsettings-desktop-schemas gtk3+ json-glib libepoxy
	libice libsm libx11 libxcomposite libxtst systemd
	xdg-desktop-portal-gnome)
makedepends=(gtk-doc docbook-xml docbook-xsl asciidoc xmlto)
source=(https://download.gnome.org/sources/$pkgname/48/$pkgname-$pkgver.tar.xz)

prepare() {
	rm -rf build && mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
