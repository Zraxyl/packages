pkgname=eog
pkgver=47.0
pkgrel=1
pkgdesc="Viewing and cataloging image files on the GNOME Desktop"
arch=(x86_64)
depends=(adwaita-icon-theme gtk4+ gnome-desktop libhandy libjpeg libpeas shared-mime-info
	glib2 lcms libexif librsvg exempi libportal)
makedepends=(itstool vala)
source=(https://download.gnome.org/sources/$pkgname/47/$pkgname-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build
	cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
