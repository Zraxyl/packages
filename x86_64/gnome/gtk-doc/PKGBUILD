pkgname=gtk-doc
pkgver=1.34.0
pkgrel=1
arch=('x86_64')
makedepends=(git meson docbook-xml docbook-xsl)
source=(https://download.gnome.org/sources/gtk-doc/1.34/gtk-doc-$pkgver.tar.xz)

prepare() {
	cd $pkgname-$pkgver

	./autogen.sh

	./configure \
	--prefix=/usr
}

build() {
	cd $pkgname-$pkgver

	make
}

package() {
	cd $pkgname-$pkgver
	make DESTDIR=$pkgdir install
}
