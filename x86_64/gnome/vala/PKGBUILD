pkgname=vala
pkgver=0.56.18
pkgrel=1
arch=('x86_64')
depends=(glib2 gcc)
makedepends=(git vala autoconf-archive automake)
source=(https://download.gnome.org/sources/vala/0.56/vala-$pkgver.tar.xz)

prepare() {
	cd $pkgname-$pkgver

	autoreconf -fvi

	./configure \
	--prefix=/usr \
	--enable-vapigen \
	--disable-valadoc
}

build() {
	cd $pkgname-$pkgver

	make CFLAGS=-w LDFLAGS=-w CXXFLAGS=-w
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR=$pkgdir install
}
