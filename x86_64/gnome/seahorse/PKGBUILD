pkgname=seahorse
pkgver=47.0.1
pkgrel=1
pkgdesc="Seahorse is a graphical interface for managing and using encryption keys. Currently it supports PGP keys (using GPG/GPGME) and SSH keys"
arch=(x86_64)
depends=(gcr gnupg gpgme libhandy libpwquality libsecret
	libsoup openssh avahi gnome-keyring)
makedepends=(itstool vala)
source=(https://download.gnome.org/sources/seahorse/47/seahorse-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build
	cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
