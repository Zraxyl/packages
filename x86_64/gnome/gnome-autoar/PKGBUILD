pkgname=gnome-autoar
pkgver=0.4.5
pkgrel=1
pkgdesc="Provides a framework for automatic archive extraction, compression, and management."
arch=(x86_64)
depends=(libarchive gtk3+ vala)
makedepends=(gtk-doc)
source=(https://download.gnome.org/sources/gnome-autoar/0.4/gnome-autoar-$pkgver.tar.xz)

prepare() {
	mkdir -p build && cd build

	meson \
	--prefix=/usr \
	--buildtype=release \
	-D vapi=true \
	-D tests=false \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
