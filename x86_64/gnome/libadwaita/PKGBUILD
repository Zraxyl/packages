pkgname=libadwaita
pkgver=1.7.2
pkgrel=1
arch=('x86_64')
depends=(gtk4+ pango fribidi glib2 appstream)
makedepends=(clang llvm vala sassc)
source=(https://download.gnome.org/sources/$pkgname/1.7/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	mkdir -p build && cd build

	CC=clang \
	CXX=clang++ \
	meson \
	--prefix=/usr \
	--buildtype=release \
	--wrap-mode=nofallback \
	..

	ninja
}

package() {
	cd $pkgname-$pkgver/build
	
	DESTDIR=$pkgdir ninja install
}
