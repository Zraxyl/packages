pkgname=kmod
pkgver=34
pkgrel=1
arch=('x86_64')
depends=(glibc zlib gettext openssl xz zstd)
makedeps=(gtk-doc)
source=(https://www.kernel.org/pub/linux/utils/kernel/$pkgname/$pkgname-$pkgver.tar.xz
	depmod-search.conf
	depmod.hook
	depmod.script)

prepare() {
	rm -rf build
	mkdir -p build

	meson \
	--default-library both \
	--wrap-mode=nofallback \
	$pkgname-$pkgver \
	build \
	--prefix=/usr \
	--bindir=/usr/bin \
	--sbindir=/usr/sbin \
	--sysconfdir=/etc \
	-D xz=enabled \
	-D zstd=enabled \
	-D zlib=enabled \
	-D openssl=enabled \
	-D manpages=false \
	-D docs=false
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install

	install -dm0755 "${pkgdir}"/{etc,usr/lib}/{depmod,modprobe}.d
	install -Dm0644 "${srcdir}/depmod-search.conf" "${pkgdir}/usr/lib/depmod.d/search.conf"
	install -Dm0644 "${srcdir}/depmod.hook" "${pkgdir}/usr/share/libalpm/hooks/60-depmod.hook"
	install -Dm0755 "${srcdir}/depmod.script" "${pkgdir}/usr/share/libalpm/scripts/depmod"

	ln -sfv kmod $pkgdir/usr/bin/lsmod
}
