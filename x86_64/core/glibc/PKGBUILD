pkgname=glibc
pkgver=2.42
pkgrel=1
pkgdesc="The project provides the core libraries for the GNU system and GNU/Linux systems"
arch=('x86_64')
depends=(libxcrypt filesystem lib32-libxcrypt tar xz coreutils binutils util-linux)
makedepends=(python3 bison m4 tar xz)
options=(!strip !lto emptydirs staticlibs)
backup=(etc/gai.conf
	etc/locale.gen
	etc/nscd.conf)
install=glibc.install
source=(https://ftp.gnu.org/gnu/$pkgname/$pkgname-$pkgver.tar.xz
	sdt.h
	sdt-config.h
	locales-install)

prepare() {
	cd $pkgname-$pkgver

	mkdir -pv build
	cd build

	echo "slibdir=/usr/lib" >> configparms
	echo "rtlddir=/usr/lib" >> configparms
	echo "sbindir=/usr/sbin" >> configparms
	echo "rootsbindir=/usr/sbin" >> configparms

	../configure \
	--prefix=/usr \
	--sysconfdir=/etc \
	--libdir=/usr/lib \
	--libexecdir=/usr/libexec \
	--bindir=/usr/bin \
	--sbindir=/usr/sbin \
	--with-headers=/usr/include \
	--disable-werror \
	--enable-add-ons \
	--enable-bind-now \
	--enable-cet \
	--enable-sframe \
	--enable-lock-elision \
	--enable-fortify-source \
	--enable-multi-arch \
	--enable-stack-protector=strong \
	--enable-stackguard-randomization \
	--enable-kernel=4.19 \
	--enable-systemtap \
	--disable-nscd \
	--disable-werror \
	--disable-profile \
	libc_cv_slibdir=/usr/lib


	mkdir -p ../build32
	cd ../build32

	echo "slibdir=/usr/lib" >> configparms
	echo "rtlddir=/usr/lib" >> configparms
	echo "sbindir=/usr/sbin" >> configparms
	echo "rootsbindir=/usr/sbin" >> configparms

	CC="gcc -m32" \
	CXX="g++ -m32" \
	../configure \
	--prefix=/usr \
	--sysconfdir=/etc \
	--libdir=/usr/lib \
	--libexecdir=/usr/libexec \
	--bindir=/usr/bin \
	--sbindir=/usr/sbin \
	--with-headers=/usr/include \
	--disable-werror \
	--enable-add-ons \
	--enable-bind-now \
	--disable-cet \
	--disable-sframe \
	--enable-lock-elision \
	--enable-fortify-source \
	--enable-multi-arch \
	--enable-stack-protector=strong \
	--enable-stackguard-randomization \
	--enable-kernel=4.19 \
	--enable-systemtap \
	--disable-nscd \
	--disable-werror \
	--disable-profile \
	i686-pc-linux-gnu
}

build() {
	cd $pkgname-$pkgver

	cd build

	make
	
	cd ../build32

	make
}

package() {
	# 64bit install
	cd $pkgname-$pkgver
	cd build

	mkdir -p $pkgdir/etc
	touch $pkgdir/etc/ld.so.conf
	make install_root=$pkgdir install

	cp -v ../nscd/nscd.conf $pkgdir/etc/nscd.conf
	mkdir -pv $pkgdir/var/cache/nscd

	mkdir -pv $pkgdir/usr/lib/locale
	make install_root=$pkgdir localedata/install-locales

	mkdir -p $pkgdir/usr/sbin
	cp -vf $srcdir/locales-install $pkgdir/usr/sbin
	chmod +x $pkgdir/usr/sbin/locales-install

	# Now lets compress the 200mb+ locale file and let bottle decompress it with script
	# Saves alot from download size ( 200mb -> 10-20mb prolly )
	oldpwd1=$(pwd)
	cd $pkgdir/usr/lib/locale
	tar cJf locale-archive.tar.xz locale-archive
	rm -f locale-archive
	cd $oldpwd1

	# 32bit
	cd ../build32	
	
	rm -rf DESTDIR	
	mkdir -p DESTDIR/usr/lib32/
	sleep 3

	make install_root=$('pwd')/DESTDIR install
	
	# Provide tracing probes to libstdc++ for exceptions, possibly for other
	# libraries too. Useful for gdb's catch command.
	install -Dm644 "${srcdir}"/sdt.h "${pkgdir}"/usr/include/sys/sdt.h
	install -Dm644 "${srcdir}"/sdt-config.h "${pkgdir}"/usr/include/sys/sdt-config.h

	install -vdm755 $pkgdir/usr/lib32
	install -vdm755 $pkgdir/usr/include/gnu
	install -vdm755 $pkgdir/etc/ld.so.conf.d

	find DESTDIR/usr/include -type f -not -name '*-32.h' -delete
	cp -rf DESTDIR/usr/include/* $pkgdir/usr/include/

	# Provided by libxcrypt; keep the old shared library for backwards compatibility
	rm -f "$pkgdir"/usr/include/crypt.h "$pkgdir"/usr/{lib,lib32}/libcrypt.{a,so}

	mkdir -vp $pkgdir/etc/ld.so.conf.d

	ln -sv ../usr/lib32/ld-linux.so.2 $pkgdir/usr/lib/ld-linux.so.2
	ln -sv ../usr/lib32/ld-linux.so.2 $pkgdir/usr/lib/ld-lsb.so.3
	ln -sv ../lib/locale $pkgdir/usr/lib32/locale

	mkdir -p $pkgdir/etc/ld.so.conf.d
	echo "/usr/lib32" > "$pkgdir/etc/ld.so.conf.d/lib32-glibc.conf"

	cat > $pkgdir/etc/nsswitch.conf << "EOF"
# Begin /etc/nsswitch.conf

passwd: files
group: files
shadow: files

hosts: files dns
networks: files

protocols: files
services: files
ethers: files
rpc: files

# End /etc/nsswitch.conf
EOF

cat > $pkgdir/etc/ld.so.conf << "EOF"
# Begin /etc/ld.so.conf
/usr/local/lib
/opt/lib

EOF

cat >> $pkgdir/etc/ld.so.conf << "EOF"
# Add an include directory
include /etc/ld.so.conf.d/*.conf

EOF
}
