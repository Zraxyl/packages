pkgname=acl
pkgver=2.3.2
pkgrel=1
arch=('x86_64')
depends=(attr)
source=(https://download.savannah.gnu.org/releases/$pkgname/$pkgname-$pkgver.tar.gz)

build() {
        cd $pkgname-$pkgver

	./configure \
	--prefix=/usr

        make
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR=$pkgdir install
}
