pkgname=bottle
pkgver=2025.1
patchver=_002
pkgrel=1
arch=('x86_64')
depends=(zstd bash glibc libarchive curl gpgme libassuan nettle)
USE_STAGING=yes
source=(https://github.com/Zraxyl/bottle/archive/refs/tags/${pkgver}${patchver}.tar.gz)

build() {
	cd $pkgname-${pkgver}${patchver}

	if [ "$USE_STAGING" == "yes" ]; then
		meson \
		--prefix=/usr \
		--sysconfdir=/etc \
		-D is-staging=true \
		-D doxygen=enabled \
		-D curl=enabled \
		-D crypto=openssl \
		-D gpgme=enabled \
		-D i18n=true \
		-D scriptlet-shell=/usr/bin/bash \
		-D ldconfig=/sbin/ldconfig \
		-D pkg-ext=.pkg.tar.gz \
		-D src-ext=.src.tar.gz \
		build
	else
		meson \
		--prefix=/usr \
		--sysconfdir=/etc \
		-D is-staging=false \
		-D doxygen=enabled \
		-D curl=enabled \
		-D crypto=openssl \
		-D gpgme=enabled \
		-D i18n=true \
		-D scriptlet-shell=/usr/bin/bash \
		-D ldconfig=/sbin/ldconfig \
		-D pkg-ext=.pkg.tar.gz \
		-D src-ext=.src.tar.gz \
		build
	fi

	ninja -C build
}

package() {
	cd $pkgname-${pkgver}${patchver}
	
	mkdir -vp $pkgdir
	export DESTDIR=$pkgdir
	
	ninja -C build install

	mkdir -p $pkgdir/etc/bottle.d
	touch $pkgdir/etc/bottle.d/mirrorlist
}
