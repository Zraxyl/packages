pkgname=duktape
pkgver=2.7.0
pkgrel=1
arch=('x86_64')
depends=(glibc)
source=(https://duktape.org/duktape-$pkgver.tar.xz)

prepare() {
	cd $pkgname-$pkgver

	sed -i 's/^#undef DUK_USE_FASTINT$/#define DUK_USE_FASTINT/' src/duk_config.h

	sed -i 's/duktape\.c/& -lm/' Makefile.sharedlibrary
}

build() {
	cd $pkgname-$pkgver

	make -f Makefile.sharedlibrary INSTALL_PREFIX=/usr
}

package() {
	cd $pkgname-$pkgver

	make -f Makefile.sharedlibrary INSTALL_PREFIX=/usr DESTDIR="$pkgdir" install
}
