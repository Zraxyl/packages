pkgname=parole
pkgver=4.18.2
xver=4.18
pkgrel=1
arch=('x86_64')
depends=(dbus-glib gst-plugins-base gst-plugins-good libxfce4ui libnotify )
source=( https://archive.xfce.org/src/apps/$pkgname/$xver/$pkgname-$pkgver.tar.bz2)

build() {
	cd $pkgname-$pkgver

	./configure \
	--prefix=/usr \
	--sysconfdir=/etc

	make
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR=$pkgdir install
}
