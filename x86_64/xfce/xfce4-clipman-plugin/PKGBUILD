pkgname=xfce4-clipman-plugin
pkgver=1.7.0
xver=1.7
pkgrel=1
arch=('x86_64')
url="https://docs.xfce.org/panel-plugins/xfce4-clipman-plugin/start"
depends=('gtk3' 'xfce4-panel' 'libxfce4ui')
makedepends=('meson' 'ninja' 'gettext' 'pkgconf')
source=("https://archive.xfce.org/src/panel-plugins/$pkgname/$xver/$pkgname-$pkgver.tar.xz")

build() {
  cd "$srcdir/$pkgname-$pkgver"
  meson setup build --prefix=/usr
  meson compile -C build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" meson install -C build
}
