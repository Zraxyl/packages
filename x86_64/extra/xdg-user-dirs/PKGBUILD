pkgname=xdg-user-dirs
pkgver=0.19
pkgrel=1
pkgdesc='Manage user directories like ~/Desktop and ~/Music'
arch=('x86_64')
depends=(bash systemd)
makedepends=(docbook-xsl git)
source=(https://gitlab.freedesktop.org/xdg/xdg-user-dirs/-/archive/v0.19/xdg-user-dirs-v0.19.tar.gz)
install=${pkgname}.install

prepare() {
	rm -rf build
	mkdir -p build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	$pkgname-v$pkgver \
	build
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
