pkgname=vulkan-utility-libraries
pkgver=1.4.335
pkgrel=1
pkgdesc="Utility libraries for Vulkan developers"
arch=('x86_64')
depends=('jsoncpp')
makedepends=('cmake' 'vulkan-headers' 'git')
source=(https://github.com/KhronosGroup/Vulkan-Utility-Libraries/archive/v${pkgver}.tar.gz)

build() {
	cd Vulkan-Utility-Libraries-$pkgver

	rm -rf build && mkdir -p build && cd build

	cmake \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_BUILD_TYPE=Release \
	..

	make
}

package() {
	cd Vulkan-Utility-Libraries-$pkgver/build

	make DESTDIR=$pkgdir install
}
