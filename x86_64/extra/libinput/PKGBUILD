pkgname=libinput
pkgver=1.28.1
pkgrel=1
arch=('x86_64')
depends=('mtdev' 'systemd' 'glib2' 'libevdev' 'libwacom')
makedepends=('wayland-protocols' 'gtk+' 'meson')
source=(https://gitlab.freedesktop.org/libinput/libinput/-/archive/$pkgver/libinput-$pkgver.tar.gz)

build() {
	meson build $pkgname-$pkgver \
	--prefix=/usr \
	-D udev-dir=/usr/lib/udev \
	-D tests=false \
	-D documentation=false

	meson compile -C build
}

package() {
	DESTDIR=$pkgdir meson install -C build
}
