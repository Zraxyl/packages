pkgname=automake
pkgver=1.18.1
pkgrel=1
arch=('x86_64')
source=(https://ftp.gnu.org/gnu/$pkgname/$pkgname-$pkgver.tar.xz)

build() {
        cd $pkgname-$pkgver

        ./configure \
	--prefix=/usr \
	--sysconfdir=/etc \
	--bindir=/usr/bin \
	--sbindir=/usr/sbin

        make
}

package() {
	cd $pkgname-$pkgver

        make DESTDIR=$pkgdir install
}
