pkgname=protobuf-c
pkgver=1.5.2
pkgrel=2
pkgdesc="Protocol Buffers implementation in C"
arch=('x86_64')
depends=(protobuf)
makedepends=(gcc)
source=(https://github.com/protobuf-c/protobuf-c/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz)

build() {
	cd $pkgname-$pkgver

	./configure \
	--prefix=/usr \
	--sysconfdir=/etc

	make
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR=$pkgdir install
}
