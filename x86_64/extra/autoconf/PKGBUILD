pkgname=autoconf
pkgver=2.72
arch=('x86_64')
pkgrel=1
source=(https://ftp.gnu.org/gnu/$pkgname/$pkgname-$pkgver.tar.gz)

build() {
        cd $pkgname-$pkgver
	
        ./configure \
	--prefix=/usr \
	--bindir=/usr/bin \
	--sbindir=/usr/sbin \
	--sysconfdir=/etc

	make
}
package() {
	cd $pkgname-$pkgver

        make DESTDIR=$pkgdir install
}
