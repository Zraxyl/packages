pkgname=libc++
pkgver=21.1.5
pkgrel=1
pkgdesc="LLVM C++ standard library"
arch=(x86_64)
depends=(llvm gcc)
makedepends=(clang ninja cmake python3)
psource="https://github.com/llvm/llvm-project/releases/download/llvmorg-$pkgver"
source=($psource/llvm-project-$pkgver.src.tar.xz)

prepare() {
	mkdir -p build

	cmake \
	-G Ninja \
	-B build \
	-S llvm-project-$pkgver.src/runtimes \
	-D CMAKE_BUILD_TYPE=Release \
	-D CMAKE_INSTALL_PREFIX=/usr \
	-D CMAKE_C_COMPILER=clang \
	-D CMAKE_CXX_COMPILER=clang++ \
	-D LLVM_ENABLE_RUNTIMES="libcxx;libcxxabi" \
	-D LLVM_EXTERNAL_LIT=/usr/bin/lit \
	-D LLVM_ENABLE_PIC=ON \
	-D LIBCXX_INSTALL_MODULES=ON \
	-D LIBCXXABI_USE_LLVM_UNWINDER=OFF
}

build() {
	ninja -C build cxx cxxabi
}

package() {
	DESTDIR=$pkgdir ninja -C build install-cxx install-cxxabi
}
