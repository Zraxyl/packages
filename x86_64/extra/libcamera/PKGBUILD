pkgname=libcamera
pkgver=0.6.0
pkgrel=1
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS"
url="https://libcamera.org/"
arch=(x86_64)
depends=(glibc gnutls libunwind yaml libyuv)
makedepends=(doxygen git glib2 gst-plugins-base libdrm
libjpeg libtiff meson qt6 sdl2 systemd python3-pip)
source=(git+https://git.libcamera.org/$pkgname/$pkgname.git#tag=v$pkgver)

prepare() {
	mkdir -p build

	pip3 install jinja2 pyyaml ply

	cd $pkgname
	printf "%s\n" "$pkgver" > .tarball-version
}

build() {
	cd build

	meson \
	--prefix=/usr \
	-D v4l2=true \
	-D tracing=disabled \
	-D documentation=disabled \
	-D test=false \
	-D gstreamer=enabled \
	-D udev=enabled \
	../$pkgname

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
