pkgname=gparted
pkgver=1.7.0
pkgrel=1
pkgdesc="A Partition Magic clone, frontend to GNU Parted"
arch=('x86_64')
depends=(gtkmm3 parted)
makedepends=(intltool itstool polkit)
source=(https://downloads.sourceforge.net/gparted/gparted/gparted-$pkgver/gparted-$pkgver.tar.gz)

build() {
	cd $pkgname-$pkgver

	./configure \
	--prefix=/usr \
	--enable-online-resize \
	--enable-libparted-dmraid \
	--enable-xhost-root \
	--disable-doc

	make
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR=$pkgdir install

	# Install policy file
	install -D -m0644 org.gnome.gparted.policy \
	"${pkgdir}"/usr/share/polkit-1/actions/org.gnome.gparted.policy
}
