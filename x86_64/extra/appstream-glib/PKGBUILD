pkgname=appstream-glib
pkgver=0.8.3
pkgrel=1
pkgdesc="Provides GObjects and helper methods to make it easy to read and write AppStream metadata"
arch=(x86_64)
depends=(curl gdk-pixbuf gtk3+ bottle libarchive yaml libxslt)
makedepends=(docbook-xml docbook-xsl)
source=(http://people.freedesktop.org/~hughsient/$pkgname/releases/$pkgname-$pkgver.tar.xz)

prepare() {
	rm -rf build
	mkdir -p build
	cd build

	meson \
	--prefix=/usr \
	--sysconfdir=/etc \
	--buildtype=release \
	-D rpm=false \
	-D alpm=true \
	../$pkgname-$pkgver
}

build() {
	cd build

	ninja
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
