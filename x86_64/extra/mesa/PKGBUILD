pkgname=mesa
pkgver=25.2.0
pkgrel=1
pkgdesc="Open-source OpenGL drivers"
arch=('x86_64')
options=(!lto)
depends=(# X11
	'libxcb' 'libx11' 'libxext' 'libxfixes' 'libxshmfence' 'libxrender' 'libxvmc' 'libxxf86vm'

	# Other
	'wayland' 'wayland-protocols' 'vulkan-icd-loader' 'libomxil-bellagio' 'libclc' 'libglvnd'
	'valgrind' 'libunwind' 'opencl-icd-loader' 'libpciaccess'
	'vdpau' 'glslang' 'libva' 'llvm'  'lm-sensors' 'spirv-llvm-translator'
	'libepoxy' 'gtk3+' 'libc++' 'libx264' 'libx265' 'fontconfig' 'libdrm'
	'libdecor' 'polly')
makedepends=('meson' 'directx-headers' 'vulkan-headers' 'opencl-headers' 'python3-pip' 'clang' 'cmake' 'byacc'
	'bison' 'rust' 'cbindgen' 'rust-bindgen' 'wayland-protocols')
source=(https://mesa.freedesktop.org/archive/$pkgname-$pkgver.tar.xz)
declare -A rust_crates=(
  bitflags         2.9.1
  cfg-if           1.0.0
  equivalent       1.0.1
  errno            0.3.12
  hashbrown        0.14.1
  indexmap         2.2.6
  libc             0.2.168
  log              0.4.27
  once_cell        1.8.0
  paste            1.0.14
  pest_derive      2.8.0
  pest_generator   2.8.0
  pest_meta        2.8.0
  pest             2.8.0
  proc-macro2      1.0.86
  quote            1.0.35
  remain           0.2.12
  roxmltree        0.20.0
  rustc-hash       2.1.1
  rustix           1.0.7
  syn              2.0.87
  thiserror-impl   2.0.11
  thiserror        2.0.11
  ucd-trie         0.1.6
  unicode-ident    1.0.12
  zerocopy-derive  0.8.13
  zerocopy         0.8.13
)

for rust_crate in "${!rust_crates[@]}"; do
	rustv="${rust_crates[$rust_crate]}"
	source+=($rust_crate-$rustv.tar.gz::https://crates.io/api/v1/crates/$rust_crate/$rustv/download)
done

prepare() {
	cd $pkgname-$pkgver

	# TODO add our own python3-mako pkg so pip wont be used
	#echo "[!]: Installing mako with pip"
	pip3 install mako pyyaml ply syn

	echo "$pkgver-zraxyl.$pkgrel" >VERSION
}

build() {
	rm -rf build
	mkdir -p build

	cd build

	CFLAGS+=" -g1"
	CXXFLAGS+=" -g1"
	export MESON_PACKAGE_CACHE_DIR="$srcdir"
	meson \
	--prefix=/usr \
	--buildtype=release \
	--wrap-mode=nodownload \
	-D b_lto=true \
	-D b_ndebug=true \
	-D platforms=x11,wayland \
	-D gallium-drivers=r300,r600,radeonsi,nouveau,virgl,svga,llvmpipe,softpipe,iris,crocus,i915,zink,d3d12 \
	-D vulkan-drivers=amd,gfxstream,intel,intel_hasvk,nouveau,swrast,virtio,microsoft-experimental \
    -D vulkan-layers=device-select,intel-nullhw,overlay,screenshot,vram-report-limit \
	-D video-codecs=vc1dec,h264dec,h264enc,h265dec,h265enc \
	-D egl=enabled \
	-D gallium-extra-hud=true \
	-D gallium-va=enabled \
	-D gallium-mediafoundation=disabled \
	-D gallium-vdpau=enabled \
	-D gallium-rusticl=true \
	-D legacy-x11=dri2 \
	-D gbm=enabled \
	-D gles1=disabled \
	-D gles2=enabled \
	-D glvnd=enabled \
	-D glx=dri \
	-D libunwind=disabled \
	-D llvm=enabled \
	-D shared-llvm=enabled \
	-D lmsensors=enabled \
	-D tools=all \
	-D rust_std=2021 \
	-D shared-glapi=enabled \
	-D android-libbacktrace=disabled \
	-D microsoft-clc=disabled \
	-D vmware-mks-stats=true \
	-D valgrind=enabled \
	../$pkgname-$pkgver/

	ninja -j6
}

package() {
	cd build

	DESTDIR=$pkgdir ninja install
}
