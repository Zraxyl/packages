pkgname=libnftnl
pkgver=1.2.8
pkgrel=1
arch=('x86_64')
depends=(libmnl)
makedepends=(gcc)
source=(https://netfilter.org/projects/libnftnl/files/libnftnl-$pkgver.tar.xz)

prepare() {
	cd $pkgname-$pkgver

	./configure \
	--prefix=/usr
}

build() {
	cd $pkgname-$pkgver

	make
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR=$pkgdir install
}
