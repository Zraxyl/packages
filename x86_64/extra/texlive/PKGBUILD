pkgname=texlive
pkgver=2025.06.07
pkgrel=1
arch=(x86_64)
depends=(cairo fontconfig freetype2 gmp icu libpaper libpng mpfr pixman zlib libjpeg
	harfbuzz libxaw libxmu libxt libxpm)
makedepends=('git' 'perl' 'autoconf-archive')
commitid=6b58166c21cc06bac005304adf7f123b3510c5de # rebuild with automake-1.18
source=(git+https://github.com/Tex-Live/texlive-source.git#commit=$commitid)

prepare() {
	# Make build dir where configure will be runned in
	rm -rf build
	mkdir -p build
	cd build

	echo "[ * ]: Running configure"

	CFLAGS=" -Wno-incompatible-pointer-types -std=gnu17" \
	ax_cv_c_float_words_bigendian=no \
	../$pkgname-source/configure \
	CC="gcc -std=gnu17" -C \
	--prefix=/usr \
	--sysconfdir=/etc \
	--disable-dvisvgm \
	--disable-native-texlive-build \
	--with-banner-add="[ ZRAXYL ]" \
	--enable-shared \
	--with-system-zlib \
	--with-system-pnglib \
	--with-system-libpaper \
	--with-system-libpng \
	--with-system-ncurses \
	--with-system-freetype2 \
	--with-system-pixman \
	--with-system-cairo \
	--without-system-harfbuzz \
	--with-system-icu \
	--with-system-gmp \
	--with-system-mpfr \
	--without-system-graphite2
}

build() {
	cd build

	echo "[ * ]: Starting make..."
	make
}

package() {
	cd build

	echo "[ * ]: Starting destdir installation"
	make DESTDIR=$pkgdir install
}
