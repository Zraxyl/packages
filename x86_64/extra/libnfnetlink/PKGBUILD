pkgname=libnfnetlink
pkgver=1.0.2
pkgrel=1
arch=('x86_64')
depends=(glibc)
source=(https://www.netfilter.org/projects/$pkgname/files/$pkgname-$pkgver.tar.bz2)

prepare() {
	cd $pkgname-$pkgver

	./configure \
	--prefix=/usr
}

build() {
	cd $pkgname-$pkgver

	make
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR=$pkgdir install
}
