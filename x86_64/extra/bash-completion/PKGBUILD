pkgname=bash-completion
pkgver=2.16.0
pkgrel=2
arch=(x86_64)
depends=('bash')
source=(https://github.com/scop/bash-completion/releases/download/$pkgver/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	./configure \
	--prefix=/usr \
	--sysconfdir=/etc

	make
}

package() {
	cd $pkgname-$pkgver
	
	make DESTDIR=$pkgdir install

	rm -f $pkgdir/etc/profile.d/bash_completion.sh
	rm -f $pkgdir/usr/share/bash-completion/completions/*
	#rm -f $pkgdir/usr/share/bash-completion/completions/{makepkg,insmod,rmmod}
}
