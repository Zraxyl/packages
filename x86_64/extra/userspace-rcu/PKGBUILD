pkgname=userspace-rcu
pkgver=0.15.3
pkgrel=1
pkgdesc="The userspace-rcu package provides a set of userspace RCU (read-copy-update) libraries"
arch=(x86_64)
depends=(glibc)
makedepends=(base-devel)
source=(https://lttng.org/files/urcu/userspace-rcu-$pkgver.tar.bz2)

build() {
	cd $pkgname-$pkgver

	./configure \
	--prefix=/usr \
	--sysconfdir=/etc

	make
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR=$pkgdir install
}
