pkgname=xvidcore
pkgver=1.3.7
pkgrel=2
pkgdesc="XviD is an open source MPEG-4 video codec"
arch=(x86_64)
depends=(glibc)
makedepends=(base-devel nasm)
source=(https://downloads.xvid.com/downloads/xvidcore-$pkgver.tar.gz)

prepare() {
	cd $pkgname/

	sed -i '/typedef int bool;/d' src/encoder.h

	cd build/generic

	autoreconf -fvi

	CC=clang \
	CXX=clang++ \
	./configure \
	--prefix=/usr \
	--sysconfdir=/etc
}

build() {
	cd $pkgname/build/generic

	make
}

package() {
	cd $pkgname/build/generic

	make DESTDIR=$pkgdir install
}
