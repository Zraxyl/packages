pkgname=libssh
pkgver=0.11.1
pkgrel=1
pkgdesc="Library for accessing ssh client services through C libraries"
arch=('x86_64')
depends=('zlib' 'openssl' 'glibc')
makedepends=('cmake' 'cmocka' 'doxygen' 'python3' 'openssh')
source=("https://www.libssh.org/files/0.11/$pkgname-$pkgver.tar.xz")

prepare() {
	  mkdir -p build
}

build() {
	cd build

	cmake ../$pkgname-$pkgver \
	-D CMAKE_INSTALL_PREFIX=/usr \
	-D WITH_GSSAPI=OFF \
	-D UNIT_TESTING=ON

	make
}

package_libssh() {
	cd build

	make DESTDIR="$pkgdir" install
}
